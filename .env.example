# Copie para .env e preencha os valores.
# ATENCAO: nenhum valor real de segredo deve ser commitado neste arquivo.

# DB
POSTGRES_HOST=kanban-db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_USER=kanban
# Troque obrigatoriamente em producao
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# API de dados
OPERA_URL=http://localhost:2111
OPERA_LINK=http://operafr-app:2111
OPERA_API_KEY=
OPERA_FOLDER_ID=1

# Segredo para autenticação
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# RabbitMQ
RABBITMQ_HOST=kanban-rabbitmq
RABBITMQ_HOST_PORT=5673
RABBITMQ_PORT=5672
RABBITMQ_PANEL_PORT=15673
RABBITMQ_USER=kanban
# Troque obrigatoriamente em producao
RABBITMQ_PASSWORD=kanban
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}

# Fila de e-mail
EMAIL_QUEUE_NAME=email_queue

# OAuth login
# Em desenvolvimento: http://localhost:3000
NEXTAUTH_URL=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Login com google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Ambiente
STAGE=development
PRODUCTION_URL=
PORT=3000 # <- Define onde roda no host

# Backup
BACKUP_PATH=/var/bkp/kanban
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAYS=
