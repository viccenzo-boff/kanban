{
  "name": "kanban",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "npm run db:migrate && next start",
    "db:migrate": "node src/database/migrate.js",
    "db:sync": "npm run db:migrate && npx prisma generate && npx prisma db pull && npx prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/jwt-payload.e2e.js && node tests/e2e/socket-auth.e2e.js",
    "dev:test": "docker exec kanban-app-dev npm test",
    "dev:test:e2e": "docker exec kanban-app-dev npm run test:e2e",
    "dev:up": "docker compose up kanban-app-dev -d",
    "dev:logs": "docker logs -f kanban-app-dev",
    "dev:down": "docker compose down",
    "dev:restart": "docker compose restart kanban-app-dev",
    "dev:sh": "docker exec -it kanban-app-dev sh",
    "dev:lint": "docker exec kanban-app-dev npm run lint",
    "dev:migrate": "docker exec -it kanban-app-dev npm run db:migrate",
    "dev:psql": "docker exec -it kanban-db psql -U kanban -d kanban"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-data-grid": "^8.x.x",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "amqplib": "^2.0.1",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.0",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.75.0",
    "react-toastify": "^11.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "vitest": "^3.2.7"
  }
}
